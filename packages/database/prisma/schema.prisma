// Prisma schema for the product-neutral platform foundation.
// Do not add product-specific tables here; extend in a product module instead.

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // Enables the `citext` type used below for `users.email` — native,
  // database-level case-insensitive uniqueness (no app-side `LOWER()` index).
  extensions = [citext]
}

// --- Enums -----------------------------------------------------------------

// `pending_verification` is kept in addition to the four statuses named in the
// Phase 3 spec (active, disabled, locked, deleted) because the existing email
// verification gate (AuthService.signUp / verifyEmail) depends on a distinct
// "not yet verified" state — collapsing it into `active` would let an
// unverified account sign in. Documented decision, see docs/auth/FINDINGS.md.
enum AccountStatus {
  pending_verification
  active
  disabled
  locked
  deleted
}

enum RoleName {
  user
  support
  moderator
  administrator
  super_administrator
}

enum OneTimeTokenPurpose {
  verify_email
  reset_password
  otp
  magic_link
}

// --- Core identity -----------------------------------------------------------

model User {
  id String @id @default(uuid())

  // citext gives case-insensitive uniqueness natively at the database level.
  // Trimming (no leading/trailing whitespace) is enforced by a CHECK constraint
  // added in the migration SQL (Prisma has no declarative CHECK support here)
  // and by `emailSchema` (`z.string().trim().toLowerCase()`) at the app boundary.
  email String @unique @db.Citext

  emailVerifiedAt DateTime?

  // Null only for OAuth-only or OTP/magic-link-only accounts (no password set).
  passwordHash String?

  status           AccountStatus @default(pending_verification)
  failedLoginCount Int           @default(0)
  lockedUntil      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  profile           Profile?
  oauthAccounts     OauthAccount[]
  sessions          Session[]
  userRoles         UserRole[]
  authEvents        AuthEvent[]
  auditLogs         AuditLog[]
  consents          Consent[]
  cookiePreferences CookiePreference[]
  notificationPrefs NotificationPreference[]
  files             File[]
  deletionRequests  AccountDeletionRequest[]
  exportRequests    DataExportRequest[]
  oneTimeTokens     OneTimeToken[]

  // Every lookup path gets an index: email is already unique (=indexed); status
  // and deletedAt back the admin/listing and soft-delete-filtering lookup paths.
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Profile {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName String?
  avatarUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

// Links an external OAuth identity (Google, Microsoft, GitHub, ...) to a User.
// Password credentials live directly on `users.passwordHash`, not here — this
// table is OAuth-only, per the Phase 3 schema spec.
model OauthAccount {
  id                      String   @id @default(uuid())
  provider                String // "google" | "microsoft" | "github" | "facebook" | "apple" | ... (any provider name, see @saas/auth's OAuthProviderAdapter registry)
  providerAccountId       String // the external provider's stable subject id (Google/GitHub/Facebook: sub/id; Microsoft: tid+oid, concatenated; Apple: sub)
  userId                  String
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailAtLinkTime         String
  emailVerifiedByProvider Boolean  @default(false)
  createdAt               DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

// Phase 9 (OAuth): a provider identity callback that resolved to a REAL
// identity but had no usable email (Facebook can omit email entirely) ends up
// here instead of creating/linking a User — the task requires asking the user
// for an email and verifying it before any account is created. A tiny,
// dedicated table rather than reusing OneTimeToken, since there is no userId
// yet at this point (that's exactly the problem being solved) and
// OneTimeToken.userId is non-nullable by design for every other purpose.
model OauthPendingIdentity {
  id                 String   @id @default(uuid())
  provider           String
  providerAccountId  String
  displayName        String?
  // The user-submitted email, pending its own verification code — set once the
  // "enter your email" step is submitted, before the code is confirmed.
  pendingEmail       String?
  // Hash of the pending-identity lookup token (carried in the "enter your
  // email" page's URL) — same hash-only-storage rule as every other token.
  lookupTokenHash    String   @unique
  // Hash of the numeric code emailed to pendingEmail, once set.
  verifyCodeHash     String?
  verifyAttempts     Int      @default(0)
  expiresAt          DateTime
  usedAt             DateTime?
  createdAt          DateTime @default(now())

  @@index([provider, providerAccountId])
  @@map("oauth_pending_identities")
}

// --- Sessions ----------------------------------------------------------------

model Session {
  id               String @id @default(uuid())
  userId           String
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String @unique

  // All sessions created by one continuous login→refresh→refresh chain share a
  // familyId; detecting a reused (already-rotated) refresh token lets the app
  // revoke the entire family as a stolen-token response, not just one session.
  familyId String @default(uuid())

  // Rolling expiry (extended on each refresh) vs. an absolute ceiling that is
  // never extended — forces a fresh login after N days even with continuous use.
  expiresAt         DateTime
  absoluteExpiresAt DateTime

  createdAt     DateTime  @default(now())
  // Updated on every authenticated request (SessionGuard), not just at creation —
  // backs idle-timeout enforcement, which is distinct from the rolling/absolute
  // refresh-token expiry above.
  lastUsedAt    DateTime  @default(now())
  revokedAt     DateTime?
  revokedReason String?

  // Set when this (now-revoked) session was rotated into a successor. Lets a
  // refresh retried within a short grace window after rotation (e.g. two tabs
  // racing, or a client retrying a timed-out-but-actually-successful request) be
  // treated as benign and resolved to the live session, instead of being treated
  // as a stolen-token replay that revokes the whole family.
  rotatedToSessionId String?

  userAgent String?
  // Hashed, never raw — sessions must never store a reversible client IP.
  ipHash    String?

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

// --- One-time tokens -----------------------------------------------------------

// Backs email verification, password reset, OTP login, and magic-link login.
// Hashes only — the raw token/code is never persisted (see @saas/security/server
// hashToken), and AUTH_RULES.md rule 4 forbids ever logging the raw value.
model OneTimeToken {
  id        String              @id @default(uuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   OneTimeTokenPurpose
  tokenHash String              @unique
  attempts  Int                 @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, purpose])
  @@map("one_time_tokens")
}

// --- Auth events (no secrets) ---------------------------------------------------

// Append-only auth lifecycle log (login/logout/signup/etc). Never stores a
// credential, token, or raw IP — ipHash only, per AUTH_RULES.md rule 4.
// `metadata` is an additive, backward-compatible extension beyond the Phase 3
// spec's literal column list, kept for non-secret contextual detail (e.g. which
// field failed validation); the "no secrets" invariant applies to it exactly as
// it did to the predecessor `security_events` table this replaces.
model AuthEvent {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String
  ipHash    String?
  userAgent String?
  requestId String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@map("auth_events")
}

// --- Roles and permissions ------------------------------------------------------

model Role {
  id          String           @id @default(uuid())
  name        RoleName         @unique
  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

model Permission {
  id    String           @id @default(uuid())
  name  String           @unique
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// --- Audit / compliance (unchanged from Phase 2 — out of this phase's scope) ----

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

model Consent {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String // e.g. "terms", "privacy"
  version    String
  acceptedAt DateTime @default(now())

  @@index([userId])
  @@map("consents")
}

model CookiePreference {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  analytics      Boolean  @default(false)
  marketing      Boolean  @default(false)
  consentVersion String
  updatedAt      DateTime @updatedAt

  @@map("cookie_preferences")
}

model NotificationPreference {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productUpdates Boolean  @default(true)
  securityAlerts Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  @@map("notification_preferences")
}

model File {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bucket    String
  objectKey String   @unique
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([ownerId])
  @@map("files")
}

model FeatureFlag {
  key         String   @id
  description String?
  enabled     Boolean  @default(false)
  rules       Json     @default("{}")
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
}

model AccountDeletionRequest {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedAt DateTime  @default(now())
  processedAt DateTime?
  status      String    @default("pending")

  @@index([userId])
  @@map("account_deletion_requests")
}

model DataExportRequest {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedAt DateTime  @default(now())
  completedAt DateTime?
  downloadUrl String?
  status      String    @default("pending")

  @@index([userId])
  @@map("data_export_requests")
}

model WebhookEvent {
  id          String    @id @default(uuid())
  source      String
  eventType   String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([source, eventType])
  @@map("webhook_events")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
