{
  "name": "saas-starter",
  "private": true,
  "version": "0.13.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm test:scripts",
    "test:scripts": "vitest run --config vitest.scripts.config.ts",
    "test:e2e": "playwright test",
    "secret-scan": "node scripts/secret-scan.mjs",
    "check:bundle-secrets": "tsx scripts/check-bundle-for-secrets.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rimraf node_modules",
    "db:migrate": "pnpm --filter @saas/database migrate:dev",
    "db:generate": "pnpm --filter @saas/database generate",
    "db:studio": "pnpm --filter @saas/database studio",
    "db:seed": "tsx packages/database/prisma/seed.ts",
    "db:check-consistency": "tsx scripts/check-db-consistency.ts",
    "check:deadcode": "knip",
    "check:duplicates": "jscpd .",
    "check:cycles": "madge --circular --extensions ts,tsx apps packages",
    "release": "node scripts/release.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jscpd": "^5.4.0",
    "knip": "^6.40.0",
    "lint-staged": "^15.3.0",
    "madge": "^8.0.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
