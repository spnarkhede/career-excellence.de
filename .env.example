# ------------------------------------------------------------------
# This file documents every environment variable used by the platform.
# Copy to .env and fill in real values for local development.
# NEVER commit a populated .env file.
# ------------------------------------------------------------------

# --- Shared ---
NODE_ENV=development
APP_ENV=local

# --- Public (safe to expose to the browser) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ANALYTICS_WRITE_KEY=

# --- Web app (apps/web) ---
WEB_PORT=3000

# --- Admin app (apps/admin) ---
ADMIN_PORT=3002

# --- API (apps/api) ---
API_PORT=4000
# Empty means "no Domain attribute" (host-only cookie) — set only if the API and
# its clients genuinely span subdomains of one parent domain.
API_COOKIE_DOMAIN=
API_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_dev
DATABASE_MIGRATE_URL=postgresql://postgres:postgres@localhost:5432/app_dev

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth provider (replace with your managed provider's values) ---
AUTH_PROVIDER=stub
AUTH_PROVIDER_API_KEY=
AUTH_PROVIDER_API_URL=
AUTH_JWT_SECRET=replace-with-a-long-random-string
# Asymmetric access-token signing (Phase 7). Leave both empty for local dev — an
# ephemeral Ed25519 keypair is generated once at process startup instead; every
# restart then invalidates outstanding access tokens (refresh tokens aren't
# affected). Generate real ones for any environment that must survive a restart:
#   node -e "const{generateKeyPairSync}=require('crypto');const{privateKey,publicKey}=generateKeyPairSync('ed25519');console.log(privateKey.export({type:'pkcs8',format:'pem'}));console.log(publicKey.export({type:'spki',format:'pem'}))"
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEY=
AUTH_JWT_KID=default
# Set these to the OUTGOING key/kid when rotating, so tokens signed under it keep
# verifying until they naturally expire.
AUTH_JWT_PREVIOUS_PUBLIC_KEY=
AUTH_JWT_PREVIOUS_KID=
AUTH_JWT_ISSUER=career-excellence-api
AUTH_JWT_AUDIENCE=career-excellence-web
AUTH_ACCESS_TOKEN_TTL=900
AUTH_REFRESH_TOKEN_TTL=2592000
AUTH_IDLE_TIMEOUT_SECONDS=1800
AUTH_REFRESH_REUSE_GRACE_MS=10000
AUTH_SESSION_COOKIE_NAME=app_session
AUTH_REFRESH_COOKIE_NAME=app_refresh
AUTH_CSRF_COOKIE_NAME=csrf_token
FEATURE_BREACHED_PASSWORD_CHECK=false

# --- OAuth: Google ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/auth/oauth/google/callback

# --- OAuth: Microsoft (optional) ---
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:4000/auth/oauth/microsoft/callback

# --- OAuth: GitHub (optional) ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:4000/auth/oauth/github/callback

# --- Email ---
EMAIL_PROVIDER=stub
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@example.com

# --- Object storage (S3 compatible) ---
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=app-private
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Observability ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Feature flags ---
FEATURE_FLAGS_PROVIDER=stub

# --- Security ---
ENCRYPTION_KEY=replace-with-a-32-byte-random-key
